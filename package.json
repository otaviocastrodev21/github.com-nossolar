{
  "name": "nosso-lar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nosso Lar — controle do enxoval, das compras e do orçamento do casal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "gen:catalog": "node scripts/gen-catalog-sql.mjs",
    "supabase:diagnosticar": "node scripts/supabase-provision.mjs --diagnosticar",
    "supabase:listar": "node scripts/supabase-provision.mjs --listar",
    "supabase:criar": "node scripts/supabase-provision.mjs --criar",
    "supabase:verificar": "node scripts/supabase-provision.mjs --so-verificar",
    "supabase:teste": "node scripts/integration-test.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "desktop:dev": "node scripts/desktop.mjs --dev",
    "desktop:start": "npm run build && node scripts/desktop.mjs",
    "desktop:verify": "npm run build && node scripts/desktop.mjs --smoke",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win",
    "desktop:dist:mac": "npm run build && electron-builder --mac",
    "desktop:dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "Nosso Lar"
  }
}
